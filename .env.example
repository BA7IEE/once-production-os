# Use `node scripts/init-local.mjs` for isolated local development, not these placeholder values.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:4318
HOST=127.0.0.1
PORT=4318
COOKIE_SECURE=false
TRUST_LOOPBACK_PROXY=false
ACCESS_MODE=MAINTENANCE
# Explicit outbound/internal export gate. Keep disabled until reviewed.
DATA_EGRESS_MODE=DISABLED
# Independent irreversible-cleanup gate. Never enable by deployment accident.
DATA_CLEANUP_MODE=DISABLED
# Controlled identity merge gate. Preview stays available; execution requires approval.
DATA_MERGE_MODE=DISABLED
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@127.0.0.1:5436/once_local
CONTACT_KEY_FILE=.secrets/contact.hex
CSRF_KEY_FILE=.secrets/csrf.hex
RECOVERY_EPOCH_FILE=.secrets/recovery.epoch
# One-time CLI only. No default password exists.
BOOTSTRAP_LOGIN=owner
BOOTSTRAP_NAME=ONCE管理员
BOOTSTRAP_PASSWORD_FILE=.secrets/bootstrap.password

# Independent append-only recovery evidence. Keep this outside the database and private media root.
# API/Worker must share the same local filesystem and lock inode; NFS/SMB is not supported.
# Never delete or replace the .lock file while any API/Worker/recovery command is running.
# SAFETY_JOURNAL_FILE=/absolute/private/path/once-safety-journal.jsonl

# Media: disabled, local (local/test), or cos (private dedicated bucket).
# COS uses the shared private MEDIA_ROOT for staging and decoding.
COS_BUCKET=
COS_REGION=
COS_PREFIX=once
# Absolute path to a mode-0600 JSON file containing SecretId and SecretKey.
COS_CREDENTIALS_FILE=
MEDIA_PROVIDER=disabled
# Set an absolute independent directory when explicitly enabling local media.
# MEDIA_ROOT=/absolute/path/to/once-private-media

# PR-02a: external talent auth remains closed by default. No provider verification implied.
TALENT_PORTAL_ENABLED=false
# TALENT_AUTH_PROVIDER=http  # test is allowed only in local/test, never staging/production
# TALENT_AUTH_ENDPOINT=https://your-owned-gateway.example/auth/send
# TALENT_AUTH_CREDENTIAL_FILE=/absolute/private/auth-provider-secret
# TALENT_AUTH_SENDER=your-approved-sender
# TALENT_AUTH_TEMPLATE=your-approved-login-template
# TALENT_AUTH_TIMEOUT_MS=10000
# TALENT_AUTH_HOURLY=100
# TALENT_AUTH_DAILY=200
# Five different 32-byte hex secret files, separate from internal credentials:
# TALENT_IDENTITY_KEY_FILE=/absolute/private/talent-identity-key
# TALENT_CODE_KEY_FILE=/absolute/private/talent-code-key
# TALENT_SESSION_KEY_FILE=/absolute/private/talent-session-key
# TALENT_MESSAGE_KEY_FILE=/absolute/private/talent-message-key
# TALENT_CSRF_KEY_FILE=/absolute/private/talent-csrf-key
# TALENT_SESSION_IDLE_DAYS=7
# TALENT_SESSION_ABSOLUTE_DAYS=30
# TALENT_CONTEXT_MINUTES=15
# TALENT_OTP_MINUTES=10
# TALENT_OTP_MAX_ATTEMPTS=5
# TALENT_OTP_RESEND_SECONDS=60
# TALENT_OTP_IDENTITY_HOURLY=5
# TALENT_OTP_IDENTITY_DAILY=10
# TALENT_OTP_IP_HOURLY=20

# PR-03 playback limits; optional, may only tighten these defaults.
MEDIA_PLAY_ACTOR_STREAMS=2
MEDIA_PLAY_WORKSPACE_STREAMS=10
MEDIA_PLAY_MAX_SECONDS=900
MEDIA_PLAY_REQUESTS_PER_MINUTE=120
MEDIA_PLAY_BYTES_PER_MINUTE=600000000

# PR-03 admission budgets. Omitted values use these defaults; overrides may only tighten.
# MEDIA_TALENT_BYTES=2000000000
# MEDIA_ENROLL_BYTES=200000000
# MEDIA_WORKSPACE_BYTES=2000000000
# MEDIA_ACTIVE_BYTES=1000000000
# MEDIA_ACTOR_ACTIVE=3
# MEDIA_WORKSPACE_ACTIVE=20
# MEDIA_ACTOR_HOURLY=100

# PR-03E retention days: integer >=1; defaults are maximums, may only be tightened.
# Actual purge also requires DATA_CLEANUP_MODE=INTERNAL_APPROVED and matching recovery epoch.
MEDIA_RETENTION_DRAFT_DAYS=90
MEDIA_RETENTION_SUBMITTED_DAYS=180
MEDIA_RETENTION_DECIDED_DAYS=30
MEDIA_RETENTION_WITHDRAWN_DAYS=7

# PR-04A controlled structured MACHINE ingestion (default closed)
AGENT_INGESTION_ENABLED=false

# PR-04B: default closed. All seven independent MACHINE budgets required before enabling.
AGENT_MEDIA_ENABLED=false
# AGENT_MEDIA_WORKSPACE_ACTIVE_UPLOADS=20
# AGENT_MEDIA_PRINCIPAL_ACTIVE_UPLOADS=3
# AGENT_MEDIA_HOURLY_UPLOADS=100
# AGENT_MEDIA_SUBMISSION_FILES=50
# AGENT_MEDIA_SUBMISSION_BYTES=500000000
# AGENT_MEDIA_PRINCIPAL_RETAINED_BYTES=1000000000
# AGENT_MEDIA_WORKSPACE_RETAINED_BYTES=2000000000
