# Use `node scripts/init-local.mjs` for isolated local development, not these placeholder values.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:4318
HOST=127.0.0.1
PORT=4318
COOKIE_SECURE=false
TRUST_LOOPBACK_PROXY=false
ACCESS_MODE=MAINTENANCE
# Explicit outbound/internal export gate. Keep disabled until reviewed.
DATA_EGRESS_MODE=DISABLED
# Independent irreversible-cleanup gate. Never enable by deployment accident.
DATA_CLEANUP_MODE=DISABLED
# Controlled identity merge gate. Preview stays available; execution requires approval.
DATA_MERGE_MODE=DISABLED
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@127.0.0.1:5436/once_local
CONTACT_KEY_FILE=.secrets/contact.hex
CSRF_KEY_FILE=.secrets/csrf.hex
RECOVERY_EPOCH_FILE=.secrets/recovery.epoch
# One-time CLI only. No default password exists.
BOOTSTRAP_LOGIN=owner
BOOTSTRAP_NAME=ONCE管理员
BOOTSTRAP_PASSWORD_FILE=.secrets/bootstrap.password

# Private image development slice: local/test only. No COS credentials or public bucket.
MEDIA_PROVIDER=disabled
# Set an absolute independent directory when explicitly enabling local media.
# MEDIA_ROOT=/absolute/path/to/once-private-media
