{
  "name": "once-production-os",
  "version": "0.1.0-dev.1",
  "private": true,
  "description": "ONCE 内部生产资源系统：首个账号、来源、人才建档开发切片",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "test:core": "node scripts/run-core-tests.mjs",
    "typecheck:core": "tsc -p packages/core/tsconfig.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p apps/admin-web/tsconfig.json",
    "build:api": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config apps/admin-web/vite.config.ts",
    "build": "node scripts/heavy-task.mjs pnpm build:sequential",
    "dev:api": "node --env-file=.env dist/apps/api/src/main.js",
    "dev:web": "vite --config apps/admin-web/vite.config.ts",
    "start": "node dist/apps/api/src/main.js",
    "worker": "node dist/apps/api/src/worker-main.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "bootstrap": "node dist/apps/api/src/bootstrap.js",
    "contract:generate": "node --experimental-strip-types scripts/generate-contract.ts",
    "contract:check": "node --experimental-strip-types scripts/generate-contract.ts --check",
    "review:static": "node scripts/static-review.mjs",
    "verify": "pnpm contract:check && pnpm typecheck && pnpm test:core && pnpm review:static && pnpm build",
    "verify:postgres": "node scripts/verify-postgres.mjs",
    "verify:browser": "node tests/acceptance/browser-resume.mjs",
    "typecheck:transport": "tsc -p apps/admin-web/tsconfig.transport.json",
    "init:local": "node scripts/init-local.mjs",
    "verify:online": "bash scripts/online-verify.sh",
    "review:package": "node scripts/check-package.mjs",
    "rebuild:json": "node --experimental-strip-types scripts/rebuild-export.ts",
    "recovery:prepare": "node --experimental-strip-types scripts/recovery-prepare.ts",
    "recovery:check": "node --experimental-strip-types scripts/recovery-check.ts",
    "safety-journal": "node --experimental-strip-types scripts/safety-journal.ts",
    "recovery:backup": "node --experimental-strip-types scripts/recovery-backup.ts",
    "recovery:approve": "node --experimental-strip-types scripts/recovery-approve.ts",
    "recovery:restore-media": "node --experimental-strip-types scripts/recovery-restore-media.ts",
    "verify:talent-intake": "node tests/acceptance/browser-talent-intake.mjs",
    "build:sequential": "pnpm build:api && pnpm build:web",
    "test:postgres:owned": "node scripts/test-postgres-owned.mjs",
    "test:lifecycle": "node --test --test-concurrency=1 tests/lifecycle/*.test.mjs",
    "test:business-flow": "node scripts/test-business-flow.mjs",
    "review:foundation": "node scripts/check-admin-foundation.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/openai": "4.0.78",
    "@ai-sdk/openai-compatible": "3.0.57",
    "@ant-design/icons": "6.3.4",
    "@ant-design/pro-components": "3.1.15-5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@prisma/client": "6.19.3",
    "ai": "7.0.118",
    "antd": "6.6.5",
    "cos-nodejs-sdk-v5": "3.0.0",
    "express": "5.1.0",
    "fs-ext": "2.1.1",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/fs-ext": "2.0.3",
    "@types/node": "22.15.30",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "playwright": "1.63.0",
    "prisma": "6.19.3",
    "typescript": "5.8.3",
    "vite": "6.4.1"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "fs-ext"
    ],
    "overrides": {
      "@nestjs/platform-express>multer": "2.3.0",
      "@prisma/config>deepmerge-ts": "8.0.1"
    }
  }
}
